# Ambiente
FLASK_ENV=development
DEBUG=true
API_PORT=5000

# Banco e segurança
DATABASE_URL=sqlite:///price_tracker.db
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_CONTENT_LENGTH=1048576
RATE_LIMIT=120
RATE_WINDOW_SECONDS=60

# Logging e automação
LOG_LEVEL=INFO
MAX_RETRIES=3

# Email opcional; sem SMTP_HOST a notificação fica em dry-run no log
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# Para produção, use por exemplo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/price_tracker
